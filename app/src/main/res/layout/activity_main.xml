<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/backgroundColor">

    <!-- Filtro: Todas / Favoritas (sempre um dos dois fica selecionado) -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleFiltro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/btnTodas">

        <Button
            android:id="@+id/btnTodas"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filtro_todas" />

        <Button
            android:id="@+id/btnFavoritas"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filtro_favoritas" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Container da lista e da mensagem vazia: ocupa só o espaço que sobra -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvReceitas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/txtVazio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/msg_sem_favoritas"
            android:textSize="18sp"
            android:textColor="@color/textColorSecondary"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
